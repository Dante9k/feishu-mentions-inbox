APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8090
PUBLIC_BASE_URL=https://mentions.example.com
RUN_BACKGROUND_WORKERS=true
WORKER_POLL_SECONDS=1
# 默认轻量模式；数据库文件保存在 Docker volume 中
DATABASE_URL=sqlite:////data/mentions.db
# Docker Hub 受限时可改为 public.ecr.aws/docker/library/python:3.12-slim
PYTHON_IMAGE=python:3.12-slim
# PyPI 访问受限时可改为组织批准的可信镜像源
PIP_INDEX_URL=https://pypi.org/simple
# Docker Hub 受限时可改为 public.ecr.aws/docker/library/postgres:16-alpine
POSTGRES_IMAGE=postgres:16-alpine

# 仅 PostgreSQL 模式使用
POSTGRES_PASSWORD=replace-with-a-url-safe-random-password
ADMIN_API_TOKEN=replace-with-at-least-32-random-characters
BITABLE_CALLBACK_TOKEN=replace-with-at-least-32-random-characters
OAUTH_STATE_SECRET=replace-with-at-least-32-random-characters
TOKEN_ENCRYPTION_SECRET=replace-with-at-least-32-random-characters

FEISHU_APP_ID=your-feishu-app-id
FEISHU_APP_SECRET=replace-me
FEISHU_VERIFICATION_TOKEN=replace-me
FEISHU_ENCRYPT_KEY=replace-me
FEISHU_TENANT_KEY=replace-me
FEISHU_REQUIRE_SIGNATURE=true
FEISHU_OAUTH_SCOPES=im:chat:readonly offline_access

BITABLE_APP_TOKEN=your-bitable-app-token
BITABLE_INBOX_TABLE_ID=your-inbox-table-id
BITABLE_SETTINGS_TABLE_ID=your-settings-table-id
BITABLE_COVERAGE_TABLE_ID=your-coverage-table-id
BITABLE_USERS_TABLE_ID=your-users-table-id
BITABLE_USER_ROLE_ID=your-employee-role-id
BITABLE_GRANT_DOCUMENT_ACCESS=true

COVERAGE_INTERVAL_SECONDS=3600
RECONCILIATION_INTERVAL_SECONDS=300
RETENTION_INTERVAL_SECONDS=3600
CONTENT_RETENTION_DAYS=180
